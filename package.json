{
  "name": "@aiwayds/dsh-profile-switch",
  "version": "0.1.0",
  "description": "dsh plugin: switch named model profiles (default model, think level, per-subagent models) interactively via the host ask-user flow — one implementation for the TUI and web surfaces, a clean fast-fail on headless",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "profile",
    "model-profile",
    "model",
    "thinking",
    "ask-user",
    "workspace"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fan56/dsh-profile-switch.git"
  },
  "homepage": "https://github.com/fan56/dsh-profile-switch",
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "src",
    "docs"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc --noEmit -p tsconfig.json",
    "link-closure": "node scripts/link-dsh-closure.mjs",
    "smoke": "node scripts/smoke-boot.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": ">=0.1.5-rc.2",
    "@deepseek-ai/dsh-user-questions": ">=0.1.5-rc.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-commands": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-user-questions": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": "0.1.5-rc.2",
    "@deepseek-ai/dsh-commands": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm": "0.1.5-rc.2",
    "@deepseek-ai/dsh-user-questions": "0.1.5-rc.2",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "author": "fliu56",
  "publishConfig": {
    "access": "public"
  }
}
